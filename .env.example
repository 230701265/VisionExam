# Copy this file to .env and fill in real values for your environment.
# .env is gitignored - never commit real secrets.

# Required. Signs/encrypts the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. The app's exam/question/user data lives in an in-memory store
# (server/storage.ts) and does not need a database to run. DATABASE_URL is
# only read by `npm run db:push` (drizzle-kit) and server/db.ts, neither of
# which is on the normal request path today.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Defaults to 5000 if not set.
# PORT=5000

# Optional, production only. If both are set, an admin account is bootstrapped
# on startup. Password must be at least 12 characters.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
